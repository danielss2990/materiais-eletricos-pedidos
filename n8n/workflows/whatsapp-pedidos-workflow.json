    {
      "parameters": {
        "jsCode": "// Valida o handshake de verificação da Meta (GET com hub.mode, hub.verify_token e hub.challenge)\nconst config = $('Configuração (Verificação)').first().json;\nconst query = $('Webhook WhatsApp (Verificação Meta)').first().json.query || {};\n\nconst ok = query['hub.mode'] === 'subscribe'\n  && !!config.verifyToken\n  && query['hub.verify_token'] === config.verifyToken;\n\nreturn [{ json: { ok, challenge: String(query['hub.challenge'] || '') } }];\n"
      },
      "id": "code-get",
      "name": "Validar Token de Verificação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
