    {
      "parameters": {
        "jsCode": "// Valida a assinatura X-Hub-Signature-256 da Meta e decide se o evento deve ir para o sistema.\n// Requer a variável de ambiente do n8n NODE_FUNCTION_ALLOW_BUILTIN=crypto.\nconst crypto = require('crypto');\n\nconst config = $('Configuração (Envio)').first().json;\nconst webhookItem = $('Webhook WhatsApp (Mensagens Meta)').first();\nconst headers = webhookItem.json.headers || {};\nconst payload = webhookItem.json.body || {};\n\n// 1. Assinatura: calculada sobre o corpo bruto exatamente como a Meta enviou\nif (config.metaAppSecret) {\n  const bin = webhookItem.binary && webhookItem.binary.data;\n  if (!bin) {\n    return [{ json: { forward: false, reason: 'Corpo bruto indisponível (ative a opção Raw Body no webhook)' } }];\n  }\n  const rawBody = bin.id\n    ? await this.helpers.binaryToBuffer(await this.helpers.getBinaryStream(bin.id))\n    : Buffer.from(bin.data, 'base64');\n\n  const received = String(headers['x-hub-signature-256'] || '').replace(/^sha256=/, '');\n  const expected = crypto.createHmac('sha256', config.metaAppSecret).update(rawBody).digest('hex');\n  const valid = received.length === expected.length\n    && crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\n\n  if (!valid) {\n    return [{ json: { forward: false, reason: 'Assinatura X-Hub-Signature-256 inválida' } }];\n  }\n}\n\n// 2. Só encaminha eventos com mensagens de clientes ou ecos do vendedor (ignora status de entrega/leitura)\nconst changes = (payload.entry || []).flatMap(e => e.changes || []);\nconst relevant = changes.some(c => c.value && (\n  (c.value.messages && c.value.messages.length) ||\n  (c.value.message_echoes && c.value.message_echoes.length)\n));\n\nif (!relevant) {\n  return [{ json: { forward: false, reason: 'Evento sem mensagens (status de entrega, leitura etc.)' } }];\n}\n\nreturn [{\n  json: {\n    forward: true,\n    payload,\n    backendUrl: String(config.backendUrl || '').replace(/\\/+$/, ''),\n    webhookSecret: config.backendWebhookSecret\n  }\n}];\n"
      },
