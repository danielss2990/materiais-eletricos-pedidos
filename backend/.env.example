# Configurações do Servidor
PORT=3000
NODE_ENV=development
APP_SECRET=segredo_corporativo_seguro_eletrica_2026

# Banco de Dados
DATABASE_DRIVER=sqlite
SQLITE_DB_PATH=data/database.sqlite
# Configurações para PostgreSQL (Produção):
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=materiais_eletricos
# PG_USER=postgres
# PG_PASSWORD=postgres

# Armazenamento Seguro de Anexos
ATTACHMENT_STORAGE_DIR=storage/attachments
MAX_ATTACHMENT_SIZE_MB=50

# Conector WhatsApp Business (Meta Cloud API & Coexistência)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=token_verificacao_meta_webhook_2026
WHATSAPP_APP_SECRET=app_secret_meta_2026
# Token de acesso da Cloud API (necessário para baixar fotos, áudios e documentos)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_GRAPH_API_VERSION=v21.0

# Orquestrador n8n
# Segredo enviado pelo n8n no cabeçalho X-Webhook-Secret (use o mesmo valor no workflow)
N8N_WEBHOOK_SECRET=troque_este_segredo_n8n_2026

# Conector E-mail Comercial
EMAIL_IMAP_HOST=imap.empresa.com.br
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=pedidos@empresa.com.br
EMAIL_IMAP_PASSWORD=senha_aplicativo_segura
EMAIL_CHECK_INTERVAL_SECONDS=60

# Motor de Inteligência Artificial Multimodal
# Opções de AI_PROVIDER: gemini, openai, local_heuristic
AI_PROVIDER=local_heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_TEMPERATURE=0.1
